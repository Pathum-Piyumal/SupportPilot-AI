{
  "name": "supportpilot-ai",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @supportpilot/web",
    "build": "npm run build --workspace @supportpilot/web",
    "typecheck": "npm run typecheck --workspace @supportpilot/web",
    "test": "npm run test --workspace @supportpilot/web",
    "lint": "eslint apps/web",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "@eslint/js": "9.39.5",
    "typescript-eslint": "8.73.0",
    "globals": "16.1.0",
    "prettier": "3.5.3"
  }
}
